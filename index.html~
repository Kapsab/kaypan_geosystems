				reposArray.forEach(repo => {
					const repoCardHTML = `
						<a href="${repo.html_url}" target="_blank" class="bg-white p-5 rounded-xl border border-slate-200 hover:border-emerald-500 hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
							<div>
								<div class="flex items-center justify-between mb-2">
									<div class="text-xs font-bold text-slate-900 group-hover:text-emerald-600 transition truncate max-w-[80%]">
										${repo.name}
									</div>
									<span class="text-[9px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full font-medium shrink-0">Public</span>
								</div>
								<p class="text-xs text-slate-600 leading-relaxed mb-4 line-clamp-2">
									${repo.description || 'No public repository layout documentation specified.'}
								</p>
							</div>
							<div class="flex items-center gap-4 text-[10px] text-slate-500 border-t border-slate-100 pt-3">
								<span class="font-medium text-slate-700 flex items-center gap-1.5">
									<span class="w-2 h-2 rounded-full ${repo.language === 'Python' ? 'bg-blue-500' : 'bg-yellow-500'}"></span>
									${repo.language || 'Data/Config'}
								</span>
								<span>⭐ ${repo.stargazers_count}</span>
							</div>
						</a>
					`;
					repoGrid.innerHTML += repoCardHTML;
				});
			}

			hubBtn.addEventListener('click', async (e) => {
				e.preventDefault();
				
				if (!portfolioContainer.classList.contains('hidden')) return;

				portfolioContainer.classList.remove('hidden');
				repoGrid.innerHTML = `
					<div class="col-span-full py-6 text-center text-xs text-slate-400 animate-pulse">
						Connecting to GitHub API channel, downloading repositories...
					</div>
				`;

				try {
					const response = await fetch(`https://github.com{GITHUB_USERNAME}/repos?sort=updated&per_page=4`);
					
					if (!response.ok) {
						// API responded with an error (e.g. rate limit), switch to fallback
						renderRepoCards(fallbackRepos);
						return;
					}
					
					const repos = await response.json();
					renderRepoCards(repos);

				} catch (error) {
					// Catches local network blocks (Ad Blockers/CORS null blocks) and cleanly loads local cards instead
					console.warn("Network request blocked by browser environment. Loading local portfolio fallback data smoothly.");
					renderRepoCards(fallbackRepos);
				}

				// Smoothly drop down focus view over newly mapped cards
				portfolioContainer.scrollIntoView({ behavior: 'smooth' });
			});
			
			// 3. Interactive Web Application Sandbox Controller
			const sandboxBtn = document.getElementById('toggle-sandbox-btn');
			const sandboxFrame = document.getElementById('demo-sandbox');
			const demoIframe = document.getElementById('demo-iframe');
			
			// Target the live GitHub Pages link created in Step 1
			const APP_DEPLOYMENT_URL = "https://kapsab.github.io/zamcalc/";

			sandboxBtn.addEventListener('click', (e) => {
				e.preventDefault();
				
				if (sandboxFrame.classList.contains('hidden')) {
					// Load app files into memory and smoothly expand view
					demoIframe.src = APP_DEPLOYMENT_URL;
					sandboxFrame.classList.remove('hidden');
					sandboxBtn.innerHTML = "Close Demo Engine &times;";
					
					// Delayed scroll to allow expanding transition to settle cleanly
					setTimeout(() => {
						sandboxFrame.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
					}, 100);
				} else {
					// Collapse container and wipe source link to drop client resource usage
					sandboxFrame.classList.add('hidden');
					demoIframe.src = "";
					sandboxBtn.innerHTML = "Interact with Demo &darr;";
				}
			});

		</script>

	</body>
</html>
